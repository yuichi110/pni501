RUN mkdir -p /build/billing/layer_34 && echo 'invoice-34' > /build/billing/layer_34/meta.txt
ENV INVOICE_OPT_34=340
RUN mkdir -p /build/billing/layer_35 && echo 'invoice-35' > /build/billing/layer_35/meta.txt
ENV INVOICE_OPT_35=350
RUN mkdir -p /build/billing/layer_36 && echo 'invoice-36' > /build/billing/layer_36/meta.txt
ENV INVOICE_OPT_36=360
RUN mkdir -p /build/billing/layer_37 && echo 'invoice-37' > /build/billing/layer_37/meta.txt
ENV INVOICE_OPT_37=370
RUN mkdir -p /build/billing/layer_38 && echo 'invoice-38' > /build/billing/layer_38/meta.txt
ENV INVOICE_OPT_38=380
RUN mkdir -p /build/billing/layer_39 && echo 'invoice-39' > /build/billing/layer_39/meta.txt
ENV INVOICE_OPT_39=390
RUN mkdir -p /build/billing/layer_40 && echo 'invoice-40' > /build/billing/layer_40/meta.txt
ENV INVOICE_OPT_40=400
RUN mkdir -p /build/billing/layer_41 && echo 'invoice-41' > /build/billing/layer_41/meta.txt
ENV INVOICE_OPT_41=410
RUN mkdir -p /build/billing/layer_42 && echo 'invoice-42' > /build/billing/layer_42/meta.txt
ENV INVOICE_OPT_42=420
RUN mkdir -p /build/billing/layer_43 && echo 'invoice-43' > /build/billing/layer_43/meta.txt
ENV INVOICE_OPT_43=430

FROM python:3.12-slim AS runtime
WORKDIR /app/billing
RUN useradd --create-home appuser
COPY --from=builder /build/billing /app/billing
USER appuser
EXPOSE 8002
CMD ["python", "-m", "billing"]
