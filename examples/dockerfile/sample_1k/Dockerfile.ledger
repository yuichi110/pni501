RUN mkdir -p /build/ledger/layer_34 && echo 'ledger-34' > /build/ledger/layer_34/meta.txt
ENV LEDGER_OPT_34=340
RUN mkdir -p /build/ledger/layer_35 && echo 'ledger-35' > /build/ledger/layer_35/meta.txt
ENV LEDGER_OPT_35=350
RUN mkdir -p /build/ledger/layer_36 && echo 'ledger-36' > /build/ledger/layer_36/meta.txt
ENV LEDGER_OPT_36=360
RUN mkdir -p /build/ledger/layer_37 && echo 'ledger-37' > /build/ledger/layer_37/meta.txt
ENV LEDGER_OPT_37=370
RUN mkdir -p /build/ledger/layer_38 && echo 'ledger-38' > /build/ledger/layer_38/meta.txt
ENV LEDGER_OPT_38=380
RUN mkdir -p /build/ledger/layer_39 && echo 'ledger-39' > /build/ledger/layer_39/meta.txt
ENV LEDGER_OPT_39=390
RUN mkdir -p /build/ledger/layer_40 && echo 'ledger-40' > /build/ledger/layer_40/meta.txt
ENV LEDGER_OPT_40=400
RUN mkdir -p /build/ledger/layer_41 && echo 'ledger-41' > /build/ledger/layer_41/meta.txt
ENV LEDGER_OPT_41=410
RUN mkdir -p /build/ledger/layer_42 && echo 'ledger-42' > /build/ledger/layer_42/meta.txt
ENV LEDGER_OPT_42=420
RUN mkdir -p /build/ledger/layer_43 && echo 'ledger-43' > /build/ledger/layer_43/meta.txt
ENV LEDGER_OPT_43=430

FROM python:3.12-slim AS runtime
WORKDIR /app/ledger
RUN useradd --create-home appuser
COPY --from=builder /build/ledger /app/ledger
USER appuser
EXPOSE 8006
CMD ["python", "-m", "ledger"]
