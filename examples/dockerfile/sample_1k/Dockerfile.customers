RUN mkdir -p /build/customers/layer_34 && echo 'customer-34' > /build/customers/layer_34/meta.txt
ENV CUSTOMER_OPT_34=340
RUN mkdir -p /build/customers/layer_35 && echo 'customer-35' > /build/customers/layer_35/meta.txt
ENV CUSTOMER_OPT_35=350
RUN mkdir -p /build/customers/layer_36 && echo 'customer-36' > /build/customers/layer_36/meta.txt
ENV CUSTOMER_OPT_36=360
RUN mkdir -p /build/customers/layer_37 && echo 'customer-37' > /build/customers/layer_37/meta.txt
ENV CUSTOMER_OPT_37=370
RUN mkdir -p /build/customers/layer_38 && echo 'customer-38' > /build/customers/layer_38/meta.txt
ENV CUSTOMER_OPT_38=380
RUN mkdir -p /build/customers/layer_39 && echo 'customer-39' > /build/customers/layer_39/meta.txt
ENV CUSTOMER_OPT_39=390
RUN mkdir -p /build/customers/layer_40 && echo 'customer-40' > /build/customers/layer_40/meta.txt
ENV CUSTOMER_OPT_40=400
RUN mkdir -p /build/customers/layer_41 && echo 'customer-41' > /build/customers/layer_41/meta.txt
ENV CUSTOMER_OPT_41=410
RUN mkdir -p /build/customers/layer_42 && echo 'customer-42' > /build/customers/layer_42/meta.txt
ENV CUSTOMER_OPT_42=420
RUN mkdir -p /build/customers/layer_43 && echo 'customer-43' > /build/customers/layer_43/meta.txt
ENV CUSTOMER_OPT_43=430

FROM python:3.12-slim AS runtime
WORKDIR /app/customers
RUN useradd --create-home appuser
COPY --from=builder /build/customers /app/customers
USER appuser
EXPOSE 8007
CMD ["python", "-m", "customers"]
