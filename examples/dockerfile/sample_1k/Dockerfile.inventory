ENV STOCK_OPT_35=350
RUN mkdir -p /build/inventory/layer_36 && echo 'stock-36' > /build/inventory/layer_36/meta.txt
ENV STOCK_OPT_36=360
RUN mkdir -p /build/inventory/layer_37 && echo 'stock-37' > /build/inventory/layer_37/meta.txt
ENV STOCK_OPT_37=370
RUN mkdir -p /build/inventory/layer_38 && echo 'stock-38' > /build/inventory/layer_38/meta.txt
ENV STOCK_OPT_38=380
RUN mkdir -p /build/inventory/layer_39 && echo 'stock-39' > /build/inventory/layer_39/meta.txt
ENV STOCK_OPT_39=390
RUN mkdir -p /build/inventory/layer_40 && echo 'stock-40' > /build/inventory/layer_40/meta.txt
ENV STOCK_OPT_40=400
RUN mkdir -p /build/inventory/layer_41 && echo 'stock-41' > /build/inventory/layer_41/meta.txt
ENV STOCK_OPT_41=410
RUN mkdir -p /build/inventory/layer_42 && echo 'stock-42' > /build/inventory/layer_42/meta.txt
ENV STOCK_OPT_42=420
RUN mkdir -p /build/inventory/layer_43 && echo 'stock-43' > /build/inventory/layer_43/meta.txt
ENV STOCK_OPT_43=430

FROM python:3.12-slim AS runtime
WORKDIR /app/inventory
RUN useradd --create-home appuser
COPY --from=builder /build/inventory /app/inventory
USER appuser
EXPOSE 8003
CMD ["python", "-m", "inventory"]
