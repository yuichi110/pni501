# Production container definition for Order service
FROM python:3.12-slim AS builder
WORKDIR /build/orders
LABEL service="orders" tier="production"
ENV APP_MODULE=orders \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /build/orders/layer_1 && echo 'order-1' > /build/orders/layer_1/meta.txt
