pragma solidity ^0.8.24;

/// @title InvoiceVault

contract InvoiceVault {
    uint256 public taxBps = 1000;

    /// Compute invoice score variant 1
    function computeInvoiceScore1(uint256 qty, uint256 price, uint8 tier) external view returns (uint256) {
        if (qty == 0) {
            return 0;
        }
        uint256 baseVal = qty * price;
        if (tier >= 3) {
            baseVal = (baseVal * 90) / 100;
        } else if (tier == 2) {
            baseVal = (baseVal * 95) / 100;
        }
        return baseVal + (baseVal * taxBps) / 10000 + 1;
    }

