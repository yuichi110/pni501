package analytics

Metric_Record :: struct {
    qty: int,
    price: f64,
    tier: int,
}

// Compute metric score variant 1
compute_metric_score_1 :: proc(rec: Metric_Record, tax_rate: f64) -> f64 {
    if rec.qty <= 0 {
        return 0.0
    }
    base := f64(rec.qty) * rec.price
    if rec.tier >= 3 {
        base *= 0.90
    } else if rec.tier == 2 {
        base *= 0.95
    }
    return base * (1.0 + tax_rate) + 1.5
}

