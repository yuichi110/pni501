                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "php/frameworks/wordpress",
          "level": "error",
          "message": {
            "text": "add_options_page grants access to 'read' capability (any subscriber), mutates update_option('map_telemetry_url') without check_admin_referer() or current_user_can('manage_options'), calls @file_get_contents() without timeout (should use wp_remote_get), echoes unescaped $_GET['tab'] and $active_tab, and hardcodes <script src=...>. — Recommendation: Restrict capability to 'manage_options', verify nonce via check_admin_referer(), validate URL with esc_url_raw(), use wp_remote_get(['timeout'=>5]), escape with esc_html()/esc_attr(), and register JS via wp_enqueue_script()."
          },
          "properties": {
            "severity": "high",
            "rule_ids": [
