          "ruleId": "common/security",
          "level": "error",
          "message": {
            "text": "Potential hardcoded secret detected in `examples/php/wp_plugin_messy/includes/rest-endpoints.php:3`. — Recommendation: Move secrets to environment variables or a secret manager and rotate exposed keys."
          },
          "properties": {
