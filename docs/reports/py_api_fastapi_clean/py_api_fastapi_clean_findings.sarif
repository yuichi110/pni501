      "results": [
        {
          "ruleId": "common/security_vulnerability",
          "level": "warning",
          "message": {
            "text": "Trivy image scan on python:3.12.6-slim-bookworm (Debian 12.7) reports 9 CRITICAL / 158 HIGH Debian OS CVEs (e.g., CVE-2026-42010 in libgnutls30, CVE-2026-31789 in openssl/libssl3), 6 pip@24.2 CVEs (CVE-2026-8643 et al.), and DS-0026 missing HEALTHCHECK. — Recommendation: Refresh the base image to the latest patched python:3.12.x-slim-bookworm (or distroless/multi-stage uv copy), remove/upgrade pip to >=26.2.0, and add a HEALTHCHECK against /healthz."
          },
          "properties": {
            "severity": "medium",
            "rule_ids": [
              "common/security_vulnerability"
            ],
            "categories": [
              "security"
            ]
          },
