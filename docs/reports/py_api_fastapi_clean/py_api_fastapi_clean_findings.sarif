                }
              }
            }
          ]
        },
        {
          "ruleId": "common/security_vulnerability",
          "level": "warning",
          "message": {
            "text": "POST /v1/orders (create_order) and GET /v1/orders/{order_id} (get_order) have no OAuth2/JWT/API-key Depends() guard, matching the TODO(security) marker at line 73. — Recommendation: Add a FastAPI Security/Depends() caller authentication and per-tenant authorization dependency to /v1/orders endpoints. / Require OAuth2/JWT or API-key authentication via FastAPI Depends() on /v1/orders endpoints before public exposure. / Add FastAPI TestClient tests covering /healthz, POST /v1/orders, GET /v1/orders/{id} (200 & 404), and AsyncWebhookClient MockTransport 2xx/error paths."
          },
          "properties": {
            "severity": "medium",
            "rule_ids": [
              "common/security_vulnerability",
              "common/runtime_verification"
            ],
            "categories": [
              "security",
              "testing"
            ]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/order_dispatch/api/routes.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "common/twelve_factor",
          "level": "note",
          "message": {
            "text": "main.py instantiates InMemoryOrderRepository by default during FastAPI lifespan startup, which is clean for local/test execution behind OrderRepository Protocol but will not share order state across multiple replicas. — Recommendation: Provide a durable external OrderRepository implementation (e.g., PostgreSQL/Redis) selectable via ServiceSettings when env == 'prod'. / Disable or protect openapi_url/docs_url in production (env=='prod') and register Starlette middleware setting X-Content-Type-Options: nosniff and X-Frame-Options: DENY."
          },
          "properties": {
            "severity": "low",
            "rule_ids": [
              "common/twelve_factor",
              "common/security_vulnerability"
            ],
            "categories": [
